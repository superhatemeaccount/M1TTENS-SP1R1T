{
  "manifest_version": 3,
  "name": "M1TTENS SP1R1T",
  "version": "1.0",
  "description": "Auto-draws the best move as an arrow on chess.com games.",
  "permissions": [
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/play/computer*",
        "https://www.chess.com/play/coach*",
        "https://www.chess.com/play/online*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}